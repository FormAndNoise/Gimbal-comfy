# =======================================================================
# ComfyUI Node Loader Ignore List (.comfyignore)
# Prevents ComfyUI from attempting to load non-node scripts as custom nodes
# =======================================================================

# Version Control & Metadata
.git/
.github/
.gitattributes
.gitignore
.comfyignore

# Documentation & Wiki
docs/
wiki/
*.md
*.rst
LICENSE
NOTICE

# Visual Assets & Workflow Examples
assets/
workflows/
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.svg
*.json

# Test Suites & Benchmarks
test_suite/
tests/
test/
*_test.py
test_*.py
benchmark*.py

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Environments & Packaging
venv/
.venv/
env/
dist/
build/
*.egg-info/


# IDE & Editor Configs
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db